{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "airgap",
  "version": "0.1.0",
  "identifier": "com.level.airgap",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "airgap",
        "width": 3000,
        "height": 1800
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CONFIG/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo.png",
      "icons/logo.png",
      "icons/logo.png",
      "icons/logo.png",
      "icons/logo.png"
    ]
  }
}